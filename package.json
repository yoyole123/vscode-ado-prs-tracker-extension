{
  "name": "ado-pr-status",
  "displayName": "ADO PR Status Tracker",
  "description": "Status-bar indicator and quick list of my active Azure DevOps PRs.",
  "version": "0.0.4",
  "publisher": "yoav-keren",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoyole123/vscode-ado-prs-tracker-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prStatusContainer",
          "title": "PR Status",
          "icon": "media/pr-icon.svg"
        }
      ]
    },
    "views": {
      "prStatusContainer": [
        {
          "id": "prStatus.prListView",
          "name": "My Pull Requests"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "prStatus.prListView",
        "contents": "No active PRs to show.\n[Refresh now](command:prStatus.refresh)\n\nIf you are not signed in, use the footer 'PRs' button or run [Sign In to Azure DevOps](command:prStatus.signIn)."
      }
    ],
    "configuration": {
      "title": "PR Status",
      "properties": {
        "prStatus.organization": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps organization slug (or URL). Leave empty to auto-discover after sign in."
        },
        "prStatus.mockMode": {
          "type": "boolean",
          "default": false,
          "description": "Use static sample data instead of Azure DevOps. Useful for testing on machines without ADO access."
        }
      }
    },
    "commands": [
      {
        "command": "prStatus.open",
        "title": "PR Status: Show My PRs (Quick List)"
      },
      {
        "command": "prStatus.reveal",
        "title": "PR Status: Open PR Sidebar"
      },
      {
        "command": "prStatus.refresh",
        "title": "PR Status: Refresh Now",
        "icon": "$(refresh)"
      },
      {
        "command": "prStatus.undismiss",
        "title": "PR Status: Undismiss a PR...",
        "icon": "$(history)"
      },
      {
        "command": "prStatus.undismissAll",
        "title": "PR Status: Undismiss All PRs",
        "icon": "$(clear-all)"
      },
      {
        "command": "prStatus.signIn",
        "title": "PR Status: Sign In to Azure DevOps"
      },
      {
        "command": "prStatus.logout",
        "title": "PR Status: Log Out of Azure DevOps"
      },
      {
        "command": "prStatus.openPr",
        "title": "Open PR in Browser"
      },
      {
        "command": "prStatus.dismissPr",
        "title": "Dismiss until next push",
        "icon": "$(close)"
      },
      {
        "command": "prStatus.moveToCategory",
        "title": "Move to Category..."
      },
      {
        "command": "prStatus.deleteCategory",
        "title": "Delete Category",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "prStatus.openPr",
          "when": "false"
        },
        {
          "command": "prStatus.dismissPr",
          "when": "false"
        },
        {
          "command": "prStatus.moveToCategory",
          "when": "false"
        },
        {
          "command": "prStatus.deleteCategory",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "prStatus.refresh",
          "when": "view == prStatus.prListView",
          "group": "navigation@1"
        },
        {
          "command": "prStatus.undismiss",
          "when": "view == prStatus.prListView && prStatus.hasDismissed",
          "group": "navigation@2"
        },
        {
          "command": "prStatus.undismissAll",
          "when": "view == prStatus.prListView && prStatus.hasDismissed",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "prStatus.moveToCategory",
          "when": "view == prStatus.prListView && viewItem == pr",
          "group": "1_modification@1"
        },
        {
          "command": "prStatus.dismissPr",
          "when": "view == prStatus.prListView && viewItem == pr",
          "group": "inline"
        },
        {
          "command": "prStatus.deleteCategory",
          "when": "view == prStatus.prListView && viewItem == customCategory",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package --out pr-status.vsix --allow-missing-repository",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
